# LLM API Keys - 将 .env.example 重命名为 .env 后填入你的密钥
# ⚠️ .env 已在 .gitignore 中排除，不会提交到 Git

# DeepSeek API Key (必填)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (如果使用 OpenAI)
OPENAI_API_KEY=

# Anthropic API Key (如果使用 Claude)
ANTHROPIC_API_KEY=

# Ollama (本地模型，通常不需要密钥)
OLLAMA_BASE_URL=http://localhost:11434
